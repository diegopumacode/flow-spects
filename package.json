{
  "name": "flow-spec",
  "version": "0.1.0",
  "description": "FlowSpec: Product-driven development CLI. Manages product flow knowledge as structured markdown files.",
  "type": "module",
  "bin": {
    "flow": "./bin/flow.js"
  },
  "files": [
    "dist",
    "bin",
    "templates"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "dev:cli": "npm run build && node bin/flow.js",
    "lint": "eslint src/",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "yaml": "^2.7.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
